{
  "name": "healwave",
  "private": false,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "dev": "vite --port 3000 --host 0.0.0.0",
    "dev:debug": "vite --port 3000 --host 0.0.0.0 --debug",
    "dev:https": "vite --port 3000 --host 0.0.0.0 --https",
    "build": "vite build",
    "build:production": "NODE_ENV=production vite build",
    "build:apps": "vite build",
    "build:analyze": "vite build --mode analyze",
    "deploy:vercel": "npm run build:production && vercel --prod",
    "deploy:netlify": "npm run build:production && netlify deploy --prod --dir=dist",
    "deploy:firebase": "npm run build:production && firebase deploy",
    "lint": "ESLINT_USE_FLAT_CONFIG=true eslint . --cache --max-warnings=0",
    "lint:fix": "ESLINT_USE_FLAT_CONFIG=true eslint . --fix --max-warnings=0",
    "lint:watch": "nodemon --watch src --ext js,jsx,ts,tsx --exec \"npm run lint\"",
    "type-check": "tsc --noEmit",
    "type-check:watch": "tsc --noEmit --watch",
    "preview": "vite preview",
    "test": "vitest --run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:watch": "vitest --watch",
    "clean": "rm -rf dist .turbo node_modules/.cache",
    "dev:clean": "npm run clean && npm run dev"
  },
  "dependencies": {
    "@cosmichub/auth": "workspace:*",
    "@cosmichub/config": "workspace:*",
    "@cosmichub/integrations": "workspace:*",
    "@cosmichub/pwa": "workspace:*",
    "@cosmichub/types": "workspace:*",
    "@cosmichub/ui": "workspace:*",
    "@eslint/js": "^8.57.1",
    "@radix-ui/react-accordion": "^1.2.11",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slider": "^1.3.5",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tabs": "^1.0.5",
    "@radix-ui/react-toast": "^1.2.14",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@types/d3": "^7.4.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3": "^7.9.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "firebase": "^10.12.2",
    "framer-motion": "^12.23.12",
    "globals": "^13.24.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.2.1",
    "react-intersection-observer": "^9.16.0",
    "react-router-dom": "^6.30.1",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^20.14.10",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.15.0",
    "@typescript-eslint/parser": "^7.15.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^2.1.4",
    "@vitest/ui": "^2.1.4",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.7",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.2.2",
    "vite": "^5.4.19",
    "vitest": "^2.1.4"
  }
}
