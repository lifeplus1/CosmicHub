{
  "extends": "../../tsconfig.apps.json",
  "compilerOptions": {
    "composite": true,
    "outDir": "./dist",
    "useDefineForClassFields": true,
    "allowImportingTsExtensions": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "types": ["vite/client", "react", "react-dom", "node"],
    "declaration": true,
    "declarationMap": true,
    "baseUrl": ".",
    "target": "ES2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "paths": {
      "@/*": ["./src/*"],
      "@cosmichub/auth": ["../../packages/auth/src"],
      "@cosmichub/config": ["../../packages/config/dist"],
      "@cosmichub/config/firebase": ["../../packages/config/src/firebase.ts"],
      "@cosmichub/integrations": ["../../packages/integrations/src"],
      "@cosmichub/ui": ["../../packages/ui/dist"],
      "@cosmichub/types": ["../../packages/types/dist"],
      "@cosmichub/analytics": ["../../packages/analytics/src"]
    }
  },
  "include": [
    "src",
    "types",
    "src/**/*",
    "src/__tests__/**/*",
    "src/test-utils/**/*"
  ],
  "exclude": ["**/*.refactor_attempt.*", "**/*.backup.*", "**/*.old.*"],
  "references": [
    { "path": "../../packages/auth" },
    { "path": "../../packages/config" },
    { "path": "../../packages/ui" },
    { "path": "../../packages/integrations" },
    { "path": "../../packages/types" },
    { "path": "../../packages/analytics" }
  ]
}
