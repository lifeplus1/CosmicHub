{
  "extends": "../../tsconfig.apps.json",
  "compilerOptions": {
    "composite": true,
    "outDir": "./dist",
    "useDefineForClassFields": true,
    "allowImportingTsExtensions": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "types": ["vite/client", "react", "react-dom", "node"],
    "declaration": true,
    "declarationMap": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@cosmichub/auth": ["../../packages/auth/src"],
      "@cosmichub/config": ["../../packages/config/dist"],
      "@cosmichub/config/firebase": ["../../packages/config/src/firebase.ts"],
      "@cosmichub/frequency": ["../../packages/frequency/src"],
      "@cosmichub/integrations": ["../../packages/integrations/src"],
      "@cosmichub/subscriptions": ["../../packages/subscriptions/src"],
      "@cosmichub/ui": ["../../packages/ui/dist"],
      "@cosmichub/types": ["../../packages/types/src"]
    }
  },
  "include": ["src", "types", "src/**/*", "src/__tests__/**/*"],
  "exclude": ["**/*.refactor_attempt.*", "**/*.backup.*", "**/*.old.*"],
  "references": [
    { "path": "../../packages/subscriptions" },
    { "path": "../../packages/auth" },
    { "path": "../../packages/config" },
    { "path": "../../packages/frequency" },
    { "path": "../../packages/ui" },
    { "path": "../../packages/integrations" },
    { "path": "../../packages/types" },
    { "path": "../../packages/analytics" }
  ]
}
