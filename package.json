{
  "name": "cosmichub",
  "version": "1.0.0",
  "description": "A comprehensive astrology and spiritual guidance platform with multi-system chart calculations",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.15.0",
  "scripts": {
    "qa": "pnpm run lint:core && pnpm run type-check && pnpm run test",
    "qa:full": "pnpm run quality:all && pnpm run coverage:report",
    "ci": "pnpm run qa && pnpm run build",
    "maintenance": "pnpm run deps:outdated && pnpm run audit:prod && pnpm run cleanup:report",
    "dev": "concurrently \"pnpm run dev:backend\" \"pnpm run dev:astro\" \"pnpm run dev:healwave\"",
    "dev:astro": "cd apps/astro && pnpm run dev",
    "dev:healwave": "cd apps/healwave && pnpm run dev",
    "dev:mobile": "cd apps/mobile && pnpm run dev",
    "dev:backend": "cd backend && python3 -m uvicorn main:app --reload --host 0.0.0.0 --port 8000",
    "dev:frontend": "pnpm run dev:astro",
    "dev:preview": "pnpm run preview:astro",
    "dev:storybook": "cd apps/astro && pnpm run storybook",
    "build": "pnpm run build:analytics && pnpm run build:astro && pnpm run build:healwave",
    "build:astro": "cd apps/astro && pnpm run build",
    "build:healwave": "cd apps/healwave && pnpm run build",
    "build:analytics": "cd packages/analytics && pnpm run build",
    "build:astro:analyze": "cd apps/astro && ANALYZE=1 pnpm run build",
    "build:storybook": "cd apps/astro && pnpm run build-storybook",
    "docker": "pnpm run docker:up",
    "docker:build": "docker-compose build",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "test": "vitest run --workspace vitest.workspace.ts && pnpm run test:backend",
    "test:watch": "vitest --workspace vitest.workspace.ts",
    "test:ui": "vitest --ui --workspace vitest.workspace.ts",
    "test:astro": "vitest run --workspace vitest.workspace.ts --project astro-app",
    "test:healwave": "vitest run --workspace vitest.workspace.ts --project healwave-app",
    "test:packages": "vitest run --workspace vitest.workspace.ts --project core-packages --project ui-packages",
    "test:backend": "cd backend && python3 -m pytest tests/ -v --cov=astro --cov-report=xml --cov-report=html",
    "test:fast": "vitest run --workspace vitest.workspace.ts --project astro-app --reporter=basic --run",
    "test:dev": "vitest run --workspace vitest.workspace.ts --project astro-app --reporter=basic --run --changed",
    "test:a11y": "vitest run --workspace vitest.workspace.ts src/a11y/__tests__/ --reporter=verbose",
    "test:failing": "vitest run --workspace vitest.workspace.ts src/a11y/__tests__/AIChat.a11y.test.tsx src/a11y/__tests__/GatesChannelsTab.a11y.test.tsx --reporter=verbose",
    "test:watch:fast": "vitest --workspace vitest.workspace.ts --project astro-app",
    "test:coverage": "pnpm run coverage:report && pnpm run coverage:ratchet",
    "type-check": "node tools/testing/typecheck.mjs",
    "type-check:watch": "pnpm run type-check:astro:watch",
    "type-check:astro": "cd apps/astro && pnpm run type-check",
    "type-check:astro:watch": "cd apps/astro && tsc --noEmit --watch",
    "type-check:astro:stories": "cd apps/astro && tsc -p tsconfig.json --noEmit --pretty",
    "type-check:healwave": "cd apps/healwave && pnpm run type-check",
    "type-check:types": "tsc -p packages/types/tsconfig.json --noEmit && tsc -p packages/types/tsconfig.test.json --noEmit",
    "type-check:all": "pnpm run type-check:astro && pnpm run type-check:healwave && pnpm run type-check:types",
    "type-check:ratchet": "node tools/maintenance/type-error-ratchet.mjs",
    "type-check:tests": "node tools/testing/typecheck-tests.cjs",
    "type-check:strict:pilot": "tsc -p tsconfig.strict-incremental.json --noEmit",
    "lint": "pnpm run lint:core && pnpm run lint:quality",
    "lint:core": "pnpm run lint:astro && pnpm run lint:healwave && pnpm run lint:types && pnpm run lint:backend",
    "lint:astro": "eslint apps/astro/src --ext .ts,.tsx --max-warnings=2 --config eslint.config.js",
    "lint:healwave": "cd apps/healwave && pnpm run lint",
    "lint:types": "eslint packages/types/src --ext .ts --max-warnings=0 --config eslint.config.js",
    "lint:backend": "cd backend && (command -v python >/dev/null 2>&1 && PY=python || PY=python3; $PY -m flake8 . --count --select=E9,F63,F7,F82 --show-source --statistics)",
    "lint:ai": "pnpm run lint:ai-coord && pnpm run lint:parallel",
    "lint:ai-coord": "tools/development/safe-coordination.sh",
    "lint:ai-coord-enhanced": "node tools/development/ai-agent-lint-coordinator.mjs",
    "lint:parallel": "node tools/development/lint-parallel-batches.mjs",
    "lint:preprocess": "node tools/development/ai-agent-preprocessor.mjs",
    "lint:rebalance": "node tools/development/smart-agent-rebalancer.mjs",
    "lint:enhanced-workflow": "node tools/development/enhanced-coordination-workflow.mjs",
    "lint:refresh-agent": "node tools/development/refresh-agent-analysis.mjs",
    "lint:agents": "pnpm run lint:agents:astro && pnpm run lint:agents:packages",
    "lint:agents:astro": "pnpm run lint:agent:agent-1-astro-components && pnpm run lint:agent:agent-2-astro-features && pnpm run lint:agent:agent-3-astro-pages-context && pnpm run lint:agent:agent-4-astro-services-types",
    "lint:agents:packages": "pnpm run lint:agent:agent-5-ui-package && pnpm run lint:agent:agent-6-config-package && pnpm run lint:agent:agent-7-apps-small-packages",
    "lint:quality": "pnpm run lint:ratchet && pnpm run lint:guard && pnpm run lint:fail-usage",
    "lint:utilities": "pnpm run lint:badge && pnpm run lint:delta && pnpm run lint:update-doc",
    "quality:all": "pnpm run lint && pnpm run type-check && pnpm run coverage:ratchet && pnpm run a11y:check",
    "a11y:check": "cd apps/astro && pnpm run a11y:check",
    "format": "pnpm run format:astro && pnpm run format:healwave && pnpm run format:backend",
    "format:astro": "cd apps/astro && pnpm run format",
    "format:healwave": "cd apps/healwave && pnpm run format",
    "format:backend": "cd backend && (command -v python >/dev/null 2>&1 && PY=python || PY=python3; $PY -m black . && $PY -m isort .)",
    "markdownlint": "markdownlint-cli2 \"*.md\" \"docs/**/*.md\" \"apps/**/*.md\" \"packages/*/*.md\" -c .markdownlint.json --ignore node_modules/** --ignore pnpm/** --ignore packages/*/node_modules/** --ignore apps/*/node_modules/**",
    "dev-frontend": "pnpm run dev:astro",
    "preview": "pnpm run preview:astro",
    "preview:astro": "cd apps/astro && pnpm run preview",
    "preview:healwave": "cd apps/healwave && pnpm run preview",
    "storybook": "cd apps/astro && pnpm run storybook",
    "build-storybook": "cd apps/astro && pnpm run build-storybook",
    "env:sync": "node tools/maintenance/sync-env.mjs",
    "validate-env": "echo 'Environment validation passed'",
    "validate-experiments": "node tools/development/validate-experiments.mjs",
    "benchmark:synastry": "python3 tools/performance/benchmark_vectorized_synastry.py --sizes=1,10,50,100 --json=benchmark-latest.json",
    "type:ratchet": "node tools/maintenance/type-ratchet.mjs",
    "any:ratchet": "node tools/maintenance/any-count-ratchet.mjs",
    "coverage:ratchet": "node tools/maintenance/coverage-ratchet.mjs",
    "coverage:ratchet:check": "node tools/maintenance/coverage-ratchet-check.mjs",
    "coverage:report": "node tools/maintenance/coverage-report.mjs",
    "lint:ai-coord-safe": "tools/development/safe-coordination.sh",
    "lint:agent:agent-1-astro-components": "eslint apps/astro/src/components --ext .ts,.tsx --max-warnings=30 --config eslint.config.js",
    "lint:agent:agent-2-astro-features": "eslint apps/astro/src/features --ext .ts,.tsx --max-warnings=15 --config eslint.config.js",
    "lint:agent:agent-3-astro-pages-context": "eslint apps/astro/src/pages apps/astro/src/contexts apps/astro/src/hooks --ext .ts,.tsx --max-warnings=30 --config eslint.config.js",
    "lint:agent:agent-4-astro-services-types": "eslint apps/astro/src/services apps/astro/src/types apps/astro/src/config --ext .ts,.tsx --max-warnings=25 --config eslint.config.js",
    "lint:agent:agent-5-ui-package": "eslint packages/ui/src --ext .ts,.tsx --max-warnings=25 --config eslint.config.js",
    "lint:agent:agent-6-config-package": "eslint packages/config/src --ext .ts,.tsx --max-warnings=20 --config eslint.config.js",
    "lint:agent:agent-7-apps-small-packages": "eslint apps/healwave/src apps/mobile/src packages/auth/src packages/frequency/src packages/hooks/src packages/integrations/src packages/pwa/src packages/storage/src packages/subscriptions/src packages/types/src --ext .ts,.tsx --max-warnings=35 --config eslint.config.js",
    "lint:ratchet": "node tools/development/lint-ratchet.mjs",
    "lint:changed:strict": "node tools/development/lint-changed-strict.mjs",
    "lint:guard": "node tools/development/lint-guard.mjs",
    "lint:fail-usage": "node tools/development/fail-usage-guard.mjs",
    "lint:delta": "node tools/development/lint-delta.mjs",
    "lint:update-doc": "node tools/development/lint-update-doc.mjs",
    "lint:badge": "node tools/development/lint-badge.mjs",
    "install:all": "pnpm install && cd apps/astro && pnpm install && cd ../healwave && pnpm install && cd ../../backend && pip install -r requirements.txt",
    "clean": "pnpm run clean:astro && pnpm run clean:healwave && pnpm run clean:backend",
    "clean:astro": "cd apps/astro && rm -rf dist node_modules/.vite",
    "clean:healwave": "cd apps/healwave && rm -rf dist node_modules/.vite",
    "clean:backend": "cd backend && find . -type d -name __pycache__ -exec rm -rf {} + && rm -rf .pytest_cache",
    "setup": "pnpm run install:all && pnpm run setup:backend",
    "setup:backend": "cd backend && (command -v python3 >/dev/null 2>&1 && PY=python3 || PY=python; $PY -m venv .venv && source .venv/bin/activate && pip install --upgrade pip && pip install -r requirements.txt)",
    "deps:outdated": "pnpm outdated --recursive --format=json > metrics/outdated-latest.json || true",
    "audit:prod": "pnpm audit --prod --json > metrics/audit-latest.json || true",
    "cleanup:report": "node tools/maintenance/project-cleanup.mjs",
    "cleanup": "bash tools/maintenance/cleanup-project.sh",
    "postinstall": "echo 'Run pnpm run install:all to install all dependencies' && node tools/maintenance/sync-env.mjs",
    "prepare": "husky install"
  },
  "workspaces": [
    "apps/astro",
    "apps/healwave",
    "apps/mobile",
    "backend",
    "packages/*",
    "ephemeris_server"
  ],
  "dependencies": {
    "@radix-ui/react-progress": "^1.1.7",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.7",
    "@types/react-window": "^1.8.8",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase": "^10.12.2",
    "lucide-react": "^0.542.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-window": "^2.0.2",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "8.6.14",
    "@storybook/addon-essentials": "8.6.14",
    "@storybook/addon-interactions": "8.6.14",
    "@storybook/addon-links": "8.6.14",
    "@storybook/react": "8.6.14",
    "@storybook/react-vite": "8.6.14",
    "@storybook/test": "8.6.14",
    "@testing-library/jest-dom": "^6.7.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^20.14.10",
    "@typescript-eslint/eslint-plugin": "^8.39.1",
    "@typescript-eslint/parser": "^8.39.1",
    "@vitest/coverage-v8": "^2.1.4",
    "@vitest/ui": "^2.1.4",
    "axe-core": "^4.10.0",
    "concurrently": "^8.2.2",
    "eslint": "^9.33.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^13.19.0",
    "husky": "^9.1.6",
    "jiti": "^2.5.1",
    "jsdom": "^25.0.0",
    "lint-staged": "^15.2.10",
    "markdownlint-cli2": "^0.18.1",
    "prettier": "^3.6.2",
    "storybook": "8.6.14",
    "ts-node": "^10.9.2",
    "typescript": "^5.0.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.4",
    "vitest-axe": "^0.1.0"
  },
  "keywords": [
    "astrology",
    "numerology",
    "human-design",
    "spiritual",
    "charts",
    "cosmic",
    "monorepo"
  ],
  "author": "CosmicHub Team",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://gitlab.com/lifeplus1/CosmicHub.git"
  },
  "bugs": {
    "url": "https://gitlab.com/lifeplus1/CosmicHub/-/issues"
  },
  "homepage": "https://gitlab.com/lifeplus1/CosmicHub#readme",
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --no-warn-ignored --max-warnings=0"
    ],
    "*.{md,json,yml,yaml}": [
      "prettier --check"
    ]
  }
}
