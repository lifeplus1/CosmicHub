{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "outDir": "./dist",
    "sourceMap": true,
    "noEmit": false
  },
  "exclude": [
    "node_modules", 
    "dist", 
    "**/*.test.*", 
    "**/*.spec.*", 
    "**/__tests__/**",
    "**/tests/**"
  ]
}
