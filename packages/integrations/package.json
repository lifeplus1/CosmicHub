{
  "name": "@cosmichub/integrations",
  "version": "1.0.0",
  "description": "Cross-app integrations for CosmicHub applications",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./api": {
      "types": "./dist/api.d.ts",
      "import": "./dist/api.js",
      "require": "./dist/api.js"
    },
    "./frequency": {
      "types": "./dist/frequency/index.d.ts",
      "import": "./dist/frequency/index.js",
      "require": "./dist/frequency/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "build:packages": "tsc",
    "dev": "tsc --watch",
    "type-check": "tsc --noEmit",
    "test": "vitest"
  },
  "dependencies": {
    "@cosmichub/types": "workspace:*",
    "@stripe/stripe-js": "^2.4.0",
    "zod": "^3.22.4",
    "zustand": "^4.4.0"
  },
  "peerDependencies": {
    "react": "^18.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "typescript": "^5.0.0",
    "vitest": "^2.1.4",
    "@vitest/ui": "^2.1.4",
    "@vitest/coverage-v8": "^2.1.4"
  },
  "files": [
    "dist",
    "src"
  ]
}
