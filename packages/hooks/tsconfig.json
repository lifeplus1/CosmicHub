{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
  // Enable project references compatibility & incremental build info for faster type-checks
  "composite": true,
  "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tsbuildinfo",
    /* Output */
    "outDir": "./dist",
    "rootDir": "./src",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noEmit": false
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "dist",
    "node_modules"
  ]
}
