{
  "extends": "../../tsconfig.packages.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tsbuildinfo",
    "rootDir": "../../"
  },
  "include": ["src/**/*", "../config/src/**/*", "../integrations/src/**/*", "../types/src/**/*"],
  "references": [],
  "exclude": [
    "dist",
    "node_modules",
    "**/*.test.*",
    "**/*.spec.*",
    "../config/src/__tests__/**/*",
    "../config/src/**/*.test.*",
    "../types/src/__tests__/**/*",
    "../types/src/**/*.test.*",
    "../integrations/src/__tests__/**/*",
    "../integrations/src/**/*.test.*"
  ]
}
