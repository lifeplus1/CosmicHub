{
  "extends": "../../tsconfig.packages.json",
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tsbuildinfo",
    "rootDir": "./src",
    "emitDeclarationOnly": false,
    "outDir": "./dist",
    "skipLibCheck": true,
    "paths": {
      "@cosmichub/config/*": ["./src/*"]
    }
  },
  "include": ["src/**/*", "vite-env.d.ts"],
  "exclude": [
    "dist",
    "node_modules",
    "**/*.test.*",
    "**/*.spec.*",
    "src/optimization/**",
    "src/testing/**"
  ]
}
