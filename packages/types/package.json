{
  "name": "@cosmichub/types",
  "version": "1.0.0",
  "description": "Shared TypeScript types for CosmicHub applications",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "dev": "tsc --project tsconfig.build.json --watch",
    "clean": "rm -rf dist",
    "test": "vitest run"
  },
  "keywords": [
    "astrology",
    "types",
    "typescript",
    "cosmichub"
  ],
  "author": "CosmicHub Team",
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.0.0",
    "vitest": "^2.1.4",
    "@vitest/ui": "^2.1.4",
    "@vitest/coverage-v8": "^2.1.4"
  },
  "dependencies": {
    "zod": "^3.22.0"
  },
  "publishConfig": {
    "access": "restricted"
  }
}
