{
  "name": "@cosmichub/ui",
  "version": "1.0.0",
  "description": "Shared UI components for CosmicHub applications",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "pnpm run clean && tsc -p tsconfig.build.json",
    "build:packages": "pnpm run build",
    "build:safe": "pnpm run clean && tsc -p tsconfig.build.json --skipLibCheck",
    "build:nochecks": "pnpm run clean && tsc -p tsconfig.nocheck.json",
    "dev": "tsc -b . --watch",
    "clean": "rm -rf dist node_modules/.tmp"
  },
  "dependencies": {
    "@cosmichub/config": "workspace:*",
    "@radix-ui/react-accordion": "^1.2.11",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slider": "^1.2.4",
    "@radix-ui/react-switch": "^1.0.3",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-toast": "^1.2.14",
    "@radix-ui/react-tooltip": "^1.2.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "react-icons": "^4.12.0",
    "tailwind-merge": "^3.3.1"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "devDependencies": {
    "typescript": "^5.0.0"
  },
  "files": [
    "dist",
    "src"
  ]
}
